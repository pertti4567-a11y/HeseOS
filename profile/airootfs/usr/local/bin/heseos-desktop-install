#!/usr/bin/env bash
set -euo pipefail
if (( EUID != 0 )); then echo 'Run with sudo.' >&2; exit 1; fi
printf 'Choose an additional desktop to install:\n1) KDE Plasma\n2) XFCE\n3) GNOME\n'
read -r -p 'Choice [1-3]: ' choice
case "$choice" in
  1) pacman -S --needed plasma-meta konsole dolphin sddm ;;
  2) pacman -S --needed xfce4 xfce4-goodies lightdm lightdm-gtk-greeter ;;
  3) pacman -S --needed gnome gdm ;;
  *) echo 'No changes made.'; exit 1 ;;
esac
echo 'Installed. Log out and choose the session in your display manager, or reboot.'
